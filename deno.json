{
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@yourrealm/sdk",
    "types": [],
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["web", "server", "dist", "realm-bundle.tsx"]
}
