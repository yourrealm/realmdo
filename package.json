{
  "name": "realmdo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "typecheck": "deno check && cargo clippy --manifest-path server/Cargo.toml --locked --all-targets -- -D warnings",
    "test": "realm-sdk test && cargo test --manifest-path server/Cargo.toml --locked",
    "fmt": "deno fmt && cargo fmt --manifest-path server/Cargo.toml",
    "fmt:check": "deno fmt --check && cargo fmt --manifest-path server/Cargo.toml --check",
    "validate": "realm-sdk validate realm.tsx",
    "logo": "deno run --allow-read --allow-write --allow-run=rsvg-convert scripts/logo/gen.ts",
    "build:pack": "realm-sdk build --out dist/realmdo.realmpack",
    "dev": "realm-sdk dev",
    "dev:server": "REALMDO_DATA_DIR=./server/data PORT=${REALMDO_PORT:-3000} cargo run --manifest-path server/Cargo.toml",
    "build:image": "docker buildx build --platform linux/amd64,linux/arm64 -t benjick/realmdo:latest .",
    "android:build": "cd android && ./gradlew testDebugUnitTest lintDebug assembleDebug",
    "android:install": "cd android && ./gradlew installDebug",
    "macos:build": "cd macos && xcodegen -q && xcodebuild -project Realmdo.xcodeproj -scheme Realmdo -derivedDataPath build -allowProvisioningUpdates test build",
    "macos:open": "open macos/build/Build/Products/Debug/realmdo.app"
  },
  "dependencies": {
    "@yourrealm/sdk": "0.0.0-alpha.1389.2e2862b1"
  },
  "devDependencies": {
    "@std/assert": "npm:@jsr/std__assert@^1",
    "esbuild": "0.25.7"
  }
}
